# Every build directory, not only the workspace's own: the application in
# `app/` opens a workspace of its own and its `target` is a gigabyte.
/target
target/

# Python
__pycache__/
*.py[cod]
*.egg-info/
/client/build/
/client/dist/
.venv/
venv/

# macOS leaves one of these in every folder it has ever displayed.
.DS_Store

# The seeded design canvases are two megabytes of editor each; the artboards
# and the script that makes them are what is kept.
/docs/mockups/*/*.html
!/docs/mockups/*/*.dc.html
/docs/mockups/first-run/frames/
/docs/mockups/main/frames/

/native/tests/golden/*-tiny-skia.png
